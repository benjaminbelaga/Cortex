.build
.DS_Store
Package.resolved
# ... except the Tuist dependency lock, which IS tracked for reproducible
# installs (verified: `tuist install` ×2 produces a byte-identical file).
# The root throwaway test manifest (Package.swift, untracked by design)
# keeps its own ignored lock.
!Tuist/Package.resolved

# Tuist generated (regenerate with: tuist generate)
*.xcodeproj
*.xcworkspace
Derived/
DerivedData/

# Xcode user data
xcuserdata/

# Build artifacts
build/
.serena/

# Personal Claude Code settings (per-project, never commit)
.claude/settings.local.json
